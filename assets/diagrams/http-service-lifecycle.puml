@startuml
!include publication-flow.iuml

start
:Phục vụ yêu cầu;
:Ứng dụng gọi Shutdown\nvới ngân sách chờ riêng;
:Đóng listener, đóng kết nối rảnh;
:Chờ kết nối đang phục vụ\ntrở về rảnh;
if (Drain xong trước\nhết ngân sách?) then (Có)
  :Trả kết quả\nđóng listener;
else (Không)
  :Shutdown trả lỗi context;
  :Handler có thể\nvẫn đang chạy;
endif
:Chủ sở hữu xử lý việc còn lại\nvà vòng đời các phụ thuộc;
stop
@enduml
