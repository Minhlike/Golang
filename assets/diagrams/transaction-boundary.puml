@startuml
!include publication-flow.iuml
start
:BeginTx thành công;\nđăng ký defer Rollback;
:Qua tx: cập nhật checks.enabled\nrồi thêm check_events(check_id, action);\ndừng ngay tại lỗi hoặc check không tồn tại;
if (Hai statement thành công?) then (Có)
  :Gọi Commit;
  if (Commit trả nil?) then (Có)
    :Xác nhận cả hai thay đổi;
  else (Lỗi)
    :Không suy kết cục lưu trữ\nchỉ từ lỗi xác nhận;
    :Đối chiếu contract driver/database\nvà định danh thao tác;
  endif
else (Không)
  :Thoát; deferred Rollback\nhoàn nguyên transaction;
endif
stop
@enduml
