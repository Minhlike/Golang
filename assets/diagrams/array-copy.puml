@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 18
skinparam defaultFontColor #000000
skinparam arrowColor #222222
skinparam map {
  BackgroundColor #F5F5F5
  BorderColor #222222
  FontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #000000
  FontSize 15
}
left to right direction

map "Mảng gốc a: [3]int" as a {
  0 => 10
  1 => 20
  2 => 30
}

map "Bản sao b: [3]int\n(sau b[0] = 99)" as b {
  0 => 99
  1 => 20
  2 => 30
}

a .right.> b : b := a\nsao chép giá trị toàn bộ ô nhớ

note bottom of a
  Phép gán mảng sao chép toàn bộ byte dữ liệu.
  a[0] vẫn giữ nguyên giá trị 10 ban đầu.
end note

note bottom of b
  b sở hữu vùng nhớ độc lập hoàn toàn.
  Thay đổi b[0] không tác động tới mảng a.
end note
@enduml
