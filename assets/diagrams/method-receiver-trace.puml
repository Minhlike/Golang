@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundCorner 6
skinparam arrowColor #222222
skinparam arrowThickness 1.2

skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #1E293B
  FontSize 14
}

left to right direction

package "1. Ô nhớ Bên gọi (Caller Scope)" as caller_box {
  object "<b>billing : Service</b>\n(Địa chỉ: 0x0040)" as billing {
    Name    = "billing"
    Port    = 8080
    Healthy = true
    Retries = 0
  }
}

package "2. Lời gọi Value Receiver" as val_box {
  object "<b>billing.Summary()</b>\nReceiver: (s Service) tại 0x0080" as summary {
    Name    = "billing" (copy)
    Port    = 8080 (copy)
    Healthy = true (copy)
    Retries = 0 (copy)
  }
}

package "3. Lời gọi Pointer Receiver" as ptr_box {
  object "<b>billing.Record(false)</b>\nReceiver: (s *Service) tại 0x00A0" as record {
    s = 0x0040 (trỏ tới &billing)
  }
}

billing -down-> summary : billing.Summary()\nSao chép toàn bộ trường (Value Copy)\nChỉ đọc an toàn, không sửa được 0x0040
billing -down-> record : billing.Record(false)\nTruyền địa chỉ (&billing = 0x0040)
record .[#10B981]up.> billing : Giải tham chiếu (*s) trực tiếp sửa 0x0040:\nHealthy = false, Retries = 1

note bottom of summary
  <b>Value Receiver:</b>
  • Nhận bản sao giá trị độc lập.
  • Đảm bảo tính bất biến của caller.
  • Thích hợp cho phép đọc hoặc biến đổi trả về bản mới.
end note

note bottom of record
  <b>Pointer Receiver:</b>
  • Nhận con trỏ tham chiếu ô nhớ gốc.
  • Thay đổi lập tức phản ánh tại caller.
  • Bắt buộc khi cần cập nhật trạng thái chung hoặc tránh copy lớn.
end note
@enduml
