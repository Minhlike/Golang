@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundCorner 6
skinparam arrowColor #222222
skinparam arrowThickness 1.2

skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #1E293B
  FontSize 14
}

left to right direction

package "1. Biến bên gọi" as caller_box {
  object "<b>billing : Service</b>" as billing {
    Name    = "billing"
    Port    = 8080
    Healthy = true
    Retries = 0
  }
}

package "2. Lời gọi Value Receiver" as val_box {
  object "<b>billing.Summary()</b>\nReceiver: s Service" as summary {
    Name    = "billing" (copy)
    Port    = 8080 (copy)
    Healthy = true (copy)
    Retries = 0 (copy)
  }
}

package "3. Lời gọi Pointer Receiver" as ptr_box {
  object "<b>billing.Record(false)</b>\nReceiver: s *Service" as record {
    s = &billing
  }
}

billing -down-> summary : sao chép giá trị Service
billing -down-> record : sao chép giá trị &billing
record .up.> billing : (*s).Healthy = false\n(*s).Retries = 1

legend bottom left
  <b>Value receiver:</b> sao chép Service, không bảo đảm deep copy.
  Gán field của s không gán field của billing; dữ liệu tham chiếu có thể dùng chung.
  <b>Pointer receiver:</b> sao chép con trỏ; gán qua *s sửa biến đích.
  Gán lại s chỉ đổi receiver cục bộ, không đổi con trỏ của caller.
end legend
@enduml
