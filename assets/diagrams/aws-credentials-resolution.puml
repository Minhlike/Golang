@startuml
!include publication-flow.iuml

top to bottom direction

package "1. Khởi tạo Cấu hình (SDK Config Bootstrap)" as init_pkg {
  rectangle "<b>config.LoadDefaultConfig(ctx)</b>\nNạp cấu hình mặc định và khởi tạo chuỗi xác thực" as resolve
}

package "2. Chuỗi Nhà cung cấp Thông tin Xác thực (Prioritized Provider Chain)" as chain_pkg {
  rectangle "<b>Ưu tiên 1 · Biến Môi trường</b>\nAWS_ACCESS_KEY_ID / SECRET_ACCESS_KEY\n(Khóa tĩnh cục bộ cho development)" as env_prov
  
  rectangle "<b>Ưu tiên 2 · Tệp Cấu hình Chia sẻ</b>\n~/.aws/credentials · ~/.aws/config\n(Named Profile hoặc AWS SSO Token)" as profile_prov
  
  rectangle "<b>Ưu tiên 3 · Định danh Workload Đám mây</b>\n• ECS Task Role (Container URI)\n• EKS Pod Identity / IRSA (OIDC Web Identity)\n• EC2 Instance Metadata Service (IMDSv2)" as workload_prov
}

package "3. Lớp Đệm & Quản lý Vòng đời (Credentials Cache & Expiry)" as cache_pkg {
  rectangle "<b>aws.CredentialsCache</b>\n• Tự động lưu trữ thông tin xác thực\n• Tự động refresh khi sắp hết hạn\n• Không gọi provider nếu token còn hạn" as cache
}

package "4. Đối tượng Cấp quyền (Resolved Credentials Object)" as result_pkg {
  rectangle "<b>aws.Credentials Struct</b>\n• AccessKeyID & SecretAccessKey\n• SessionToken (Bắt buộc với khóa tạm thời)\n• CanExpire = true · Expires = timestamp" as creds
}

resolve -down-> env_prov : 1. Kiểm tra env
resolve -down-> profile_prov : 2. Kiểm tra profile
resolve -down-> workload_prov : 3. Truy vấn metadata

env_prov -down-> cache : Khóa tĩnh
profile_prov -down-> cache : Khóa phiên
workload_prov -down-> cache : Khóa tạm thời IAM Role

cache -down-> creds : Retrieve(ctx) trả về

note right of cache_pkg
  <b>Nguyên tắc Bảo mật Đám mây:</b>
  • Không ghi cứng khóa dài hạn trong mã nguồn hoặc ảnh container.
  • Trên Production: luôn ưu tiên Workload Identity cấp token ngắn hạn (15 phút - 1 giờ).
end note
@enduml
