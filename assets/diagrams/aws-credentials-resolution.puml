@startuml
!include publication-flow.iuml
top to bottom direction
rectangle "<b>config.LoadDefaultConfig</b>\nChọn provider theo cấu hình" as resolve
rectangle "<b>NGUỒN CẤU HÌNH</b>\nBiến môi trường\nShared files / profile\nSSO / web identity" as config
rectangle "<b>NGUỒN CỦA WORKLOAD</b>\nContainer credentials\nECS / EKS Pod Identity\nEC2 IMDS" as workload
rectangle "<b>aws.CredentialsCache</b>\nRetrieve(ctx): lấy / giữ credential" as cache
rectangle "<b>aws.Credentials</b>\nAccessKeyID + SecretAccessKey\nCredential tạm thời: thêm token,\nCanExpire và Expires" as value
resolve -down-> config : nguồn phù hợp
resolve -down-> workload : nguồn phù hợp
config -[hidden]right-> workload
config -down-> cache
workload -down-> cache
cache -down-> value
@enduml
