@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 17
skinparam defaultFontColor #000000
skinparam rectangle {
  BackgroundColor #F4F4F1
  BorderColor #000000
  FontColor #000000
  RoundCorner 4
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontName "Source Sans 3"
  FontSize 16
  FontColor #000000
}
skinparam arrowColor #000000
left to right direction

rectangle source [
package main

import "fmt"

const service = "checkout"

func classify(status int) string { ... }

func main() {
    status := 503
    label := classify(status)
    fmt.Println(service, label)
}
]
note right of source
  package main: khai báo tên gói (package)
  import: nạp thư viện từ gói khác
  const và func: khai báo cấp tệp nguồn
  main: hàm khởi điểm của chương trình thực thi
  status, label: biến cục bộ trong khối lệnh main
end note
@enduml
