@startuml
!include publication-flow.iuml
top to bottom direction
rectangle "<b>Kho Git cục bộ</b>\nBlob, tree, commit, tag và refs\nĐọc/ghi đối tượng không cần GitHub\nKhông suy ra go-git hỗ trợ reflog" as local
rectangle "<b>Ứng dụng Go</b>\ngo-git: đối tượng và refs trong kho\ngo-github: client GitHub REST API\nClone/fetch/push có thể cần mạng" as bot
rectangle "<b>Dịch vụ GitHub</b>\nPull request, issue, check, workflow\nAPI qua HTTPS; webhook đi ngược về bot\nXử lý lỗi mạng, hạn mức và HMAC" as remote
local <-down-> bot : Thao tác kho
bot <-down-> remote : API / webhook
@enduml
