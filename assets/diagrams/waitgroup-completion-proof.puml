@startuml
!include publication-flow.iuml

top to bottom direction

rectangle "<b>WORKER</b>\nRegistry.Add\nLock; append report" as write
rectangle "Nhả registry.mu\nUnlock" as unlock
rectangle "Báo hoàn tất\nwg.Done()" as done
rectangle "<b>BÊN CHỜ</b>\nwg.Wait() trả về\nCounter đã về 0" as wait
rectangle "Registry.Snapshot\nLock; copy reports" as snapshot

write -down-> unlock
unlock -down-> done
wait -down-> snapshot
write -[hidden]right-> wait
done -[dashed,norank]-> wait : Hoàn tất đợt việc
unlock -[dashed,norank]-> snapshot : Unlock → Lock

note bottom of done
  Add(N) trước khi chạy.
  Done đồng bộ trước Wait
  mà nó giải phóng.
end note
@enduml
