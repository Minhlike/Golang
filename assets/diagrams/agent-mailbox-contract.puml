@startuml
!include publication-flow.iuml
top to bottom direction
rectangle "<b>Agent A gửi message</b>\nQuy định copy / ownership của dữ liệu" as sender
rectangle "<b>Mailbox của Agent B</b>\nNhận yêu cầu; quy định capacity\nĐầy / đóng: trả lỗi hay chờ theo policy" as mailbox
rectangle "<b>B xử lý state của mình</b>\nMột consumer nếu cần xử lý tuần tự\nJoin vòng xử lý khi kết thúc lifecycle" as owner
rectangle "<b>Policy ứng dụng, không là isolation có sẵn</b>\nGo không tự cấm direct call\nMessage có pointer vẫn có thể alias" as boundary
sender -down-> mailbox : Gửi theo contract
mailbox -down-> owner : Bàn giao message
owner -down-> boundary
@enduml
