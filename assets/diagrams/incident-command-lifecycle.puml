@startuml
!include publication-flow.iuml

start
:Bên gọi chọn executable và đối số;\nkiểm tra quyền và dữ liệu đầu vào;
if (Spec hợp lệ?) then (Không)
  :Trả Result{} và ErrInvalidSpec;\nchưa khởi chạy;
else (Có)
  :Tạo context con với Timeout;\nCommandContext; hai bytes.Buffer;
  :cmd.Run(): thử start, chờ tiến trình\nvà thu stdout / stderr;
  note right
    Kill: tiến trình trực tiếp;
    không dọn cả cây.
    WaitDelay=0: có thể
    chờ pipe còn mở.
  end note
  :Dựng Result: Command, Stdout, Stderr,\nExitCode, TimedOut;
  if (runCtx.Err() khác nil?) then (Có)
    :Ưu tiên lỗi context;\nTimedOut chỉ khi DeadlineExceeded;
  else (Không)
    :Phân loại nil, ExitError\nhoặc lỗi start;
  endif
  :Trả Result và error;\nbên gọi chọn báo cáo / ghi nhận;
endif
stop
@enduml
