@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 18
skinparam defaultFontColor #000000
skinparam arrowColor #222222
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #000000
  FontSize 15
}
top to bottom direction

object "Biến bên gọi: balance" as caller {
  type = int
  value = 100
}

object "Tham số: x" as param {
  type = int
  value = 120 (ban đầu: 100)
}

caller -down-> param : addBonus(balance)\nsao chép giá trị 100

note right of caller
  balance và x là hai biến riêng.
  balance vẫn bằng 100.
end note

note right of param
  x += 20 chỉ sửa tham số cục bộ.
  Không giả định stack, heap hay địa chỉ vật lý.
end note
@enduml
