@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 18
skinparam defaultFontColor #000000
skinparam arrowColor #222222
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #000000
  FontSize 15
}
top to bottom direction

object "Biến bên gọi: amount" as amount {
  type = int
  value = 120 (ban đầu: 100)
}

object "Tham số hàm: balance" as pointer {
  type = *int
  value = &amount
}

pointer -down-> amount : cùng biến đích

note right of pointer
  balance nhận bản sao của giá trị &amount.
  Toán tử *balance giải tham chiếu để truy cập ô nhớ đích.
end note

note right of amount
  Phép toán *balance += 20 ghi vào biến đích,
  làm thay đổi biến amount của bên gọi từ 100 thành 120.
end note
@enduml
