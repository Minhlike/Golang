@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundCorner 6
skinparam arrowColor #222222
skinparam arrowThickness 1.2

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #000000
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #1E293B
  FontSize 14
}

top to bottom direction

rectangle "<b>1. io.ErrUnexpectedEOF</b>\nSentinel của ví dụ" as root_err
rectangle "<b>2. *ProbeFailure</b>\nService, Endpoint và Cause\nUnwrap() trả về Cause" as domain_err
rectangle "<b>3. fmt.Errorf</b>\nprobe %q: %w\nĐối số: name, failed" as wrap_err
rectangle "<b>4a. errors.Is</b>\nKhớp io.ErrUnexpectedEOF" as is_check
rectangle "<b>4b. errors.As</b>\nLấy *ProbeFailure" as as_check

root_err -down-> domain_err : Cause
domain_err -down-> wrap_err : %w
wrap_err -down-> is_check
wrap_err -down-> as_check
@enduml
