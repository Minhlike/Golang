@startuml
!include publication-flow.iuml

start

:Bắt đầu hàm runWithSession(ctx);

if (ctx.Err() != nil?) then (Đã hủy / Timeout)
  :Trả về lỗi ctx.Err();
  note right
    Thoát sớm;
    không mở session;
    không gọi Close().
  end note
  stop
else (Hợp lệ)
  :Thực hiện mở session;
  if (Mở thành công?) then (Lỗi)
    :Trả về lỗi mở session;
    stop
  else (Thành công)
    :Đăng ký defer session.Close();
    :Thực thi run(ctx, session);
    
    if (run() có lỗi?) then (Có lỗi)
      :defer đóng session;
      :Giữ nguyên lỗi chính của run();
      note right
        Lỗi Close() chỉ log;
        không đè lỗi run().
      end note
      stop
    else (Thành công)
      :defer đóng session;
      if (Close() lỗi?) then (Có lỗi)
        :Trả về lỗi Close();
        stop
      else (Thành công)
        :Trả về nil;
        stop
      endif
    endif
  endif
endif

@enduml
