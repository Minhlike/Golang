@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam rectangle {
  BackgroundColor #F7F7F4
  BorderColor #5D5D5D
  FontColor #111111
  RoundCorner 8
}
skinparam note {
  BackgroundColor #FFFCE1
  BorderColor #777777
}

rectangle "source revision\ncommit đã chọn" as source
rectangle "build\nartifact digest" as build
rectangle "evidence\ntest + provenance" as evidence
rectangle "promotion policy\nquyền + gate" as policy
rectangle "desired state\ndigest được deploy" as deploy
rectangle "rollout observation\nstatus + signal" as observe

source --> build
build --> evidence
evidence --> policy
policy --> deploy
deploy --> observe

note bottom of policy
  Mỗi bước chỉ chứng minh
  contract của chính nó.
end note
@enduml
