@startuml
!include publication-flow.iuml
start
:<b>GitHub POST → Go HTTP handler</b>\nRaw body + X-Hub-Signature-256\nHandler giới hạn body; giữ đúng byte\nKhông serialize lại JSON để tính MAC;
:<b>VerifyHMACSHA256</b>\nTừ chối secret rỗng / header sai\nTính HMAC-SHA256(secret, rawBody)\nSo sánh hai MAC bằng hmac.Equal;
if (MAC khớp?) then (Có)
  :Bàn giao payload đã xác minh\ncho bộ xử lý sự kiện;
else (Không)
  :Từ chối trước khi xử lý sự kiện;
endif
stop
@enduml
