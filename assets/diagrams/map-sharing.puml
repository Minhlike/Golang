@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 18
skinparam defaultFontColor #000000
skinparam arrowColor #222222
skinparam map {
  BackgroundColor #F5F5F5
  BorderColor #222222
  FontColor #000000
}
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #000000
  FontSize 15
}
left to right direction

object "Biến: registry\n(Map Header Pointer)" as registry {
  ptr = &hmap
}

object "Biến: alias\n(alias := registry)" as alias {
  ptr = &hmap
}

map "Cấu trúc Bảng băm dùng chung (hmap)" as hmap {
  count => 1
  buckets => &bucket_array
  "billing" => 2
}

registry::ptr -right-> hmap : Tham chiếu cùng hmap
alias::ptr -right-> hmap : Tham chiếu cùng hmap

note bottom of alias
  Map trong Go là một con trỏ trỏ tới struct hmap runtime.
  Phép gán alias := registry chỉ sao chép địa chỉ con trỏ.
end note

note bottom of hmap
  Cả hai biến đều thao tác trên cùng một bảng băm.
  Ghi dữ liệu qua alias lập tức phản ánh khi đọc từ registry.
end note
@enduml
