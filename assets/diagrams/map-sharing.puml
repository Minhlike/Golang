@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 18
skinparam defaultFontColor #000000
skinparam arrowColor #222222
skinparam map {
  BackgroundColor #F5F5F5
  BorderColor #222222
  FontColor #000000
}
skinparam object {
  BackgroundColor #FFFFFF
  BorderColor #222222
  FontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #555555
  FontColor #000000
  FontSize 15
}
top to bottom direction

object "Biến: registry" as registry {
  type = map[string]int
}

object "Biến: alias\n(alias := registry)" as alias {
  type = map[string]int
}

map "Dữ liệu map dùng chung" as data {
  "billing" => 2
}

registry -[hidden]right-> alias
registry -down-> data : truy cập phần tử
alias -down-> data : truy cập cùng phần tử

note right of alias
  alias := registry sao chép giá trị map.
  Không sao chép dữ liệu phần tử.
end note

note bottom of data
  Cả hai biến đều thao tác trên cùng một bảng băm.
  Ghi dữ liệu qua alias lập tức phản ánh khi đọc từ registry.
end note
@enduml
