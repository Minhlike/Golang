@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundCorner 6
skinparam arrowColor #222222
skinparam arrowThickness 1.2

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #334155
  FontColor #0F172A
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #000000
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #1E293B
  FontSize 14
}

top to bottom direction

package "cmd/opsprobe (Gốc Lắp ghép / Composition Root)" as pkg_cmd {
  rectangle "<b>main.go</b>\n• Tiếp nhận cờ lệnh & biến môi trường\n• Ánh xạ config.Target sang probe.Service\n• Điều phối vòng lặp kiểm tra và in stdout" as cmd_content
}

package "internal/config (Ranh giới Cấu hình)" as pkg_config {
  rectangle "<b>config.go</b>\n• Tách host:port bằng net.SplitHostPort\n• Kiểm tra tính hợp lệ phạm vi cổng 1–65535\n• <i>internal/</i>: kiểm tra prefix import path trong module mode" as config_content
}

package "probe (Nghiệp vụ Cốt lõi / Domain Package)" as pkg_probe {
  rectangle "<b>probe.go / doc.go</b>\n• Khai báo Service, Endpoint, Result\n• Check nhận runner, không nạp cấu hình\n• Không import config hay cmd" as probe_content
}

pkg_cmd -down-> pkg_config : <b>1. Nạp mục tiêu</b>\n(config.DefaultTargets / LoadTargets)
pkg_cmd -down-> pkg_probe : <b>2. Thực thi kiểm tra</b>\n(probe.Check)

pkg_config -[hidden]down-> pkg_probe

note right of pkg_probe
  <b>Đồ thị import của lab:</b>
  Hai mũi tên là hai import thực.
  probe không import config hay cmd.
  config cũng không import probe.
  Go từ chối chu trình import.
end note
@enduml
