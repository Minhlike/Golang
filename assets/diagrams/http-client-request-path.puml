@startuml
!include publication-flow.iuml

start
:Tạo request\nvới context bên gọi;
if (Có kết nối HTTP/1.x\ndùng lại được?) then (Có)
  :Chọn kết nối từ pool;
else (Chưa có)
  :Thiết lập kết nối mới:\nDNS nếu cần phân giải;\nTCP; TLS nếu dùng HTTPS;
endif
:Gửi request,\nnhận response headers;
:Bên gọi đọc hoặc xử lý resp.Body;
:Bên gọi đóng resp.Body\ntrên mọi đường thoát;
stop
@enduml
