@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #444444
  FontColor #000000
  RoundCorner 4
}

skinparam arrowColor #333333
skinparam ArrowThickness 1.1

title DÒNG THỜI GIAN CÁC CỘT MỐC TIẾN HÓA CỦA GO (2007 – 2026)

rectangle "2007: Khởi thảo Ý tưởng\n---\nPhác thảo mục tiêu giải quyết\nbế tắc scale tại Google" as y2007
rectangle "2008: Compiler Thử nghiệm\n---\nTrình biên dịch mẫu;\ncú pháp ngôn ngữ dần ổn định" as y2008
rectangle "2009: Mở Mã Nguồn\n---\nCông bố mã nguồn mở (10/11/2009)\nCộng đồng toàn cầu tham gia" as y2009
rectangle "2012: Go 1.0 Ra Mắt\n---\nCam kết tương thích dài hạn\n(Go 1 Compatibility Promise)" as y2012

rectangle "2015: Go 1.5 Tự thân\n---\nCompiler/runtime viết bằng Go & asm\nConcurrent Garbage Collector" as y2015
rectangle "2018: Go 1.11 Modules\n---\nQuản lý phụ thuộc chuẩn hóa (go.mod)\nGiải phóng khỏi $GOPATH" as y2018
rectangle "2022: Go 1.18 Generics\n---\nBổ sung Tham số kiểu (Generics)\nTrừu tượng hóa an toàn kiểu tĩnh" as y2022
rectangle "2026: Go 1.27 Đương đại\n---\nGeneric Methods trên kiểu dữ liệu\nTối ưu hóa PGO & toolchain hiện đại" as y2026

y2007 -right-> y2008
y2008 -right-> y2009
y2009 -right-> y2012

y2012 --> y2015 : Tiến trình tự lưu chuyển & mở rộng

y2015 -right-> y2018
y2018 -right-> y2022
y2022 -right-> y2026
@enduml
