@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam roundCorner 6
skinparam arrowColor #222222
skinparam arrowThickness 1.2

skinparam interface {
  BackgroundColor #F1F5F9
  BorderColor #0F172A
  FontColor #0F172A
  FontStyle bold
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #000000
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #1E293B
  FontSize 14
}

left to right direction

class "<b>renderSummary</b>\n(Bên tiêu dùng)" as consumer <<func>> {
  src: SummarySource
  kết quả: string
}

interface "<b>SummarySource</b>" as contract {
  + Summary(): string
}

class "<b>Service</b>\n(Đối tượng nghiệp vụ)" as service {
  + Name: string
  + Port: int
  + Healthy: bool
  --
  + Summary(): string
}

class "<b>StaticTarget</b>\n(Kiểu được định nghĩa)" as static {
  kiểu nền: string
  --
  + Summary(): string
}

consumer ..> contract : phụ thuộc

service ..|> contract : Summary() string
static ..|> contract : Summary() string

note bottom of contract
  <b>Thỏa mãn interface:</b>
  Không khai báo implements.
  Tập method phải đủ Summary().
  Consumer chọn hợp đồng nhỏ.
  Các kiểu không cần kế thừa nhau.
end note
@enduml
