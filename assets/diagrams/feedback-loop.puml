@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Source Sans 3"
skinparam defaultFontSize 13
skinparam defaultFontColor #000000

skinparam activity {
  BackgroundColor #F9F9F9
  BorderColor #444444
  FontColor #000000
  DiamondBackgroundColor #EEEEEE
  DiamondBorderColor #222222
  RoundCorner 4
}

skinparam arrowColor #333333
skinparam ArrowThickness 1.1

title VÒNG LẶP PHẢN HỒI THỰC NGHIỆM KHI HỌC VÀ LẬP TRÌNH GO

start
repeat
  :1. Đặt giả thuyết kỹ thuật;
  :2. Chỉnh sửa nhỏ nhất (Minimal edit - một biến số);
  :3. Thực thi bộ công cụ tiêu chuẩn\n• go fmt ./...\n• go vet ./...\n• go test ./...;
  if (Kết quả thực tế bác bỏ giả thuyết?) then (Có - Bác bỏ)
    :Nhánh Có: Chẩn đoán lỗi\n• Đọc tín hiệu từ compiler / test failure\n• Xác định nguyên nhân gốc rễ (Root Cause);
  else (Không - Phù hợp)
    :Nhánh Không: Xác nhận tri thức\n• Ghi nhận kiến thức xác thực\n• Tạo commit sạch;
    stop
  endif
repeat while (Điều chỉnh lại giả thuyết & lặp lại)
@enduml
