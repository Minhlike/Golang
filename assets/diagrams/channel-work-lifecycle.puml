@startuml
!include publication-flow.iuml
top to bottom direction

rectangle "<b>Dispatcher</b>\nGửi job; đóng jobs" as dispatcher
rectangle "<b>jobs</b>\nchan Job" as jobs
rectangle "<b>Workers</b>\nNhận job, gọi Work\nGửi result hoặc dừng vì ctx" as workers
rectangle "<b>Coordinator</b>\nChờ dispatcher và workers\nĐóng results đúng một lần" as coordinator
rectangle "<b>results</b>\nchan Result" as results
rectangle "<b>Consumer</b>\nNhận tới khi đóng và cạn" as consumer

dispatcher -down-> jobs
jobs -down-> workers
coordinator -down-> results
results -down-> consumer
dispatcher -[hidden]right-> coordinator
jobs -[hidden]right-> results
workers -[hidden]right-> consumer
dispatcher -[dashed,norank]-> coordinator : dispatcherDone
workers -[dashed,norank]-> coordinator : wg.Done()
workers -[norank]-> results
@enduml
